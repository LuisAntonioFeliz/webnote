{
  "name": "webnote-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run prisma:generate && next build",
    "postinstall": "prisma generate --schema ../backend/prisma/schema.prisma",
    "start": "next start",
    "lint": "next lint",
    "prisma:generate": "prisma generate --schema ../backend/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema ../backend/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema ../backend/prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "dexie": "^4.0.0",
    "jose": "^6.2.17",
    "next": "^16.0.0",
    "next-auth": "^4.24.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sweetalert2": "^11.26.25"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "^6.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true
  }
}
